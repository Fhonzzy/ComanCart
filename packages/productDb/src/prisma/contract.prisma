model Product {
  id        Int      @id @default(autoincrement())
  name String
  shortDescription String
  description String
  price Int
  sizes String[]
  colors String[]
  images Json
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAt()
  categorySlug String
  category Category @relation(fields: [categorySlug], references: [slug])
}

model Category {
  id        Int      @id @default(autoincrement())
  name String
  slug String @unique
  products Product[]
}